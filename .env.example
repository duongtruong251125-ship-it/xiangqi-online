# Set this in your shell or User Secrets; never add credentials here.
ConnectionStrings__XiangqiOnline=Server=.;Database=XiangqiOnlineDB;Trusted_Connection=True;TrustServerCertificate=True
Cors__AllowedOrigins__0=http://localhost:5173
# Set Jwt:SigningKeyBase64 via User Secrets or environment only; use at least 32 random bytes encoded as Base64.
# Optional IP rate limit overrides: RateLimits__AuthLoginPerMinute=5, RateLimits__AuthRegisterPer10Minutes=5, RateLimits__AuthRefreshPerMinute=10
# Frontend API base URL is relative to Vite's development proxy by default.
VITE_API_BASE_URL=/api/v1
